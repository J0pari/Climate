{
  "schema_version": 1,
  "interface_id": "climate.commons.v1",
  "repository_id": "J0pari/Climate",
  "supported_control_level": "read",
  "scheduler_contract": {
    "schema": "work-scheduler/v1",
    "pin_path": "contracts/work-scheduler-pin.json",
    "owner": "commons"
  },
  "entrypoints": {
    "inspect": [
      "python",
      "architecture/inspect_repository.py",
      "--json"
    ],
    "run_experiment": [
      "python",
      "src/experiment_runtime.py",
      "--experiment",
      "<experiment-spec>",
      "--output-dir",
      "<output-dir>"
    ],
    "submit_experiment": [
      "python",
      "architecture/commons_control.py",
      "submit-cpu",
      "--experiment",
      "<experiment-spec>",
      "--repository-revision",
      "<git-sha>",
      "--run-scope",
      "<run-scope>",
      "--ram",
      "<MiB>"
    ],
    "live_read_witness": [
      "python",
      "architecture/commons_live_witness.py",
      "--experiment",
      "<experiment-spec>",
      "--repository-revision",
      "<git-sha>",
      "--run-scope",
      "<run-scope>",
      "--ram",
      "<MiB>"
    ],
    "validate_external_import": [
      "python",
      "architecture/commons_control.py",
      "validate-external-import",
      "--evaluation",
      "<evaluation-id>",
      "--subject-ref",
      "<external-artifact-ref.json>",
      "--predictions",
      "<native-predictions.json>",
      "--receipt",
      "<native-runtime-receipt.json>"
    ]
  },
  "produces": [
    "ExperimentOutcome",
    "RunManifest",
    "MetricResult",
    "EvidenceRecord",
    "ArtifactRef",
    "BudgetReport"
  ],
  "accepts": [
    "Commons run/trace/correlation/causation identity",
    "Commons scheduler contract verification",
    "content-addressed Training artifact identity for explicit Climate evaluation",
    "Commons evaluation-exchange/v1 external artifact references",
    "content-addressed native external runtime receipts for exact output import"
  ],
  "scientific_authority": {
    "contract": "contracts/climate.cue",
    "experiments": "experiments/",
    "methods": "methods/",
    "claims": "claims/",
    "evidence": "evidence/"
  },
  "limitations": [
    "work-scheduler/v1 contract compatibility does not itself satisfy the R4 live integrated-execution witness",
    "Commons does not own Climate scientific interpretation or evidence promotion",
    "The Training-artifact evaluator can validate exact native-output imports, but Climate still does not launch or emulate the Training model runtime itself."
  ]
}
