{
  "schema_version": 1,
  "authority": "repository authority for generated research-state and planning projections",
  "surfaces": [
    {
      "id": "planning",
      "kind": "machine_authority",
      "authority_paths": [
        "architecture/planning_graph.json"
      ],
      "projection": "docs/ROADMAP.md",
      "renderer": "architecture/render_roadmap.py"
    },
    {
      "id": "repository_state",
      "kind": "machine_authority_set",
      "authority_paths": [
        "architecture/planning_graph.json",
        "architecture/modules/*.json",
        "architecture/data_authorities.json",
        "architecture/station_providers.json",
        "architecture/semantic_hazards.json",
        "architecture/commons_interface.json",
        "methods/registry.json",
        "methods/sheaf-realization.v1.json",
        "claims/registry.json",
        "evidence/registry.json",
        "experiments/*.json",
        "configurations/**/*.json",
        "evaluations/**/*"
      ],
      "projection": "docs/generated/STATE.md",
      "renderer": "architecture/render_state.py"
    },
    {
      "id": "execution",
      "kind": "external_exact_head",
      "authority_paths": [
        "GitHub Actions workflow runs keyed by exact commit SHA"
      ]
    },
    {
      "id": "history",
      "kind": "git_history",
      "authority_paths": [
        "Git commit history"
      ]
    }
  ],
  "worker_orientation": [
    "Resolve the current main commit before substantial work.",
    "Read AGENTS.md and docs/generated/STATE.md from that commit.",
    "If main moved since the last orientation, inspect the intervening commits before reusing prior state conclusions.",
    "Consult exact-head GitHub Actions whenever execution status matters."
  ]
}
